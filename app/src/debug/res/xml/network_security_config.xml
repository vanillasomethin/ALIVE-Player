<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: instrumentation tests download from a localhost socket
     (AssetDownloaderFlipTest), which Android's default cleartext block rejects.
     Scoped to loopback so real traffic still has to be https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
