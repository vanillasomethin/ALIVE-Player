<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ── Media renderers (hidden until content plays) ─────
         Wrapped so PlaybackActivity can rotate this container in software
         (see applyContentRotation()) instead of relying on Activity
         requestedOrientation. Many budget/OEM Android TV panels accept an
         orientation request without physically rotating, which otherwise
         squeezes portrait content into a small region of the landscape
         panel instead of filling it. -->
    <FrameLayout
        android:id="@+id/content_rotator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:use_controller="false"
            app:resize_mode="fit" />

        <ImageView
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scaleType="fitCenter" />

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ── "Waiting for content" overlay ─────────────────── -->
    <RelativeLayout
        android:id="@+id/waiting_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/alive_ink"
        android:visibility="visible">

        <!-- Bottom-right corner: alive● wordmark -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="alive"
                android:textColor="#33ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.03" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="1dp"
                android:background="@drawable/shape_dot_red"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <!-- Bottom-center: network status indicator -->
        <LinearLayout
            android:id="@+id/network_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/network_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_dot_red" />

            <TextView
                android:id="@+id/network_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textColor="@color/alive_muted"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:letterSpacing="0.15" />

        </LinearLayout>

        <!-- Center: alive● logo + status card -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Large alive● -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="alive"
                    android:textColor="@color/alive_white"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="-0.04" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/shape_dot_red"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <!-- Status card -->
            <LinearLayout
                android:id="@+id/status_card"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_code_card"
                android:padding="24dp">

                <!-- Spinner (FETCHING / null) -->
                <ProgressBar
                    android:id="@+id/waiting_progress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="16dp"
                    android:indeterminateTint="@color/alive_red" />

                <!-- Status icon label (NO_SCHEDULE / ERROR / OK) -->
                <TextView
                    android:id="@+id/status_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠"
                    android:textSize="28sp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Headline (mirrors the old waiting_status) -->
                <TextView
                    android:id="@+id/waiting_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting for content…"
                    android:textColor="@color/alive_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:letterSpacing="0.04"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <!-- Detail line (admin URL, error msg, etc.) -->
                <TextView
                    android:id="@+id/status_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/alive_muted"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Download progress bar -->
                <ProgressBar
                    android:id="@+id/download_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progressTint="@color/alive_red"
                    android:progressBackgroundTint="@color/code_card_border"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/retry_now_button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Retry Now"
                    android:textColor="@color/alive_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_bold"
                    android:background="@drawable/bg_ghost_button"
                    android:stateListAnimator="@null"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- ── Admin control bar (top-right, always visible) ───────────── -->
    <LinearLayout
        android:id="@+id/admin_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:alpha="0.55"
        android:background="@drawable/bg_code_card"
        android:padding="6dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_rotate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⟳"
            android:textSize="18sp"
            android:textColor="@color/alive_white"
            android:background="@null"
            android:stateListAnimator="@null"
            android:padding="0dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/code_card_border" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="↺"
            android:textSize="18sp"
            android:textColor="@color/alive_white"
            android:background="@null"
            android:stateListAnimator="@null"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ── New content banner (shown briefly when plan updates) ─────── -->
    <LinearLayout
        android:id="@+id/new_content_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC1a2332"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓  New content available — updating schedule"
            android:textColor="@color/alive_white"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- ── Download corner widget (bottom-right, both during waiting and play) -->
    <LinearLayout
        android:id="@+id/download_corner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:background="@drawable/bg_code_card"
        android:padding="10dp"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/download_corner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓ 0 / 0"
            android:textColor="@color/alive_white"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/download_corner_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="80dp"
            android:layout_height="4dp"
            android:progressTint="@color/alive_red"
            android:progressBackgroundTint="@color/code_card_border" />

    </LinearLayout>

    <!-- ── Offline badge (shows during playback when network is lost) ── -->
    <TextView
        android:id="@+id/offline_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:text="● OFFLINE"
        android:textColor="@color/alive_white"
        android:textSize="10sp"
        android:fontFamily="@font/poppins_regular"
        android:letterSpacing="0.1"
        android:background="@drawable/bg_red_button"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- ── Diagnostic overlay (long-press waiting screen → PIN → shown) ── -->
    <FrameLayout
        android:id="@+id/diag_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_code_card"
            android:padding="28dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNOSTICS"
                android:textColor="@color/alive_red"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:letterSpacing="0.22"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/diag_device_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID: —"
                android:textColor="@color/alive_white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/diag_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: —"
                android:textColor="@color/alive_white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/diag_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version: —"
                android:textColor="@color/alive_white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/diag_last_fetch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last fetch: —"
                android:textColor="@color/alive_white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/diag_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage: —"
                android:textColor="@color/alive_white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/diag_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending uploads: —"
                android:textColor="@color/alive_white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/code_card_border"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap anywhere outside to close"
                android:textColor="@color/alive_muted"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_regular" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
