<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alive_ink"
    android:padding="48dp">

    <!-- ── Top-left: alive● wordmark ──────────────────────── -->
    <LinearLayout
        android:id="@+id/logo_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="alive"
            android:textColor="@color/alive_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="-0.03" />

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="3dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/shape_dot_red"
            android:layout_gravity="center_vertical" />

    </LinearLayout>

    <!-- ── Top-right: demo badge ─────────────────────────── -->
    <TextView
        android:id="@+id/demo_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text="DEMO"
        android:textColor="@color/alive_white"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:background="@drawable/bg_red_button"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone" />

    <!-- ── Main content: left brand + right device card ──── -->
    <LinearLayout
        android:id="@+id/content_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: brand headline + instructions (55%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="55"
            android:orientation="vertical"
            android:paddingEnd="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE SETUP"
                android:textColor="@color/alive_red"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.22"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/pairing_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seen.\nRemembered.\nBought."
                android:textColor="@color/alive_white"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name this screen, then tap Register. The device ID will appear in your admin dashboard so you can verify and assign a schedule."
                android:textColor="@color/alive_muted"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.5" />

        </LinearLayout>

        <!-- Right: device card (45%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="45"
            android:orientation="vertical"
            android:background="@drawable/bg_code_card"
            android:padding="36dp">

            <!-- ── STEP 1: Name + Register (shown before claim) ── -->
            <LinearLayout
                android:id="@+id/card_step_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE NAME"
                    android:textColor="@color/alive_muted"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.22"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/device_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. Lobby TV, Floor 2"
                    android:textColor="@color/alive_white"
                    android:textColorHint="@color/alive_muted"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:background="@null"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingStart="0dp"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/code_card_border"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARDWARE KEY"
                    android:textColor="@color/alive_muted"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.22"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/claim_code_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    android:textColor="@color/alive_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="20dp" />

                <!-- QR codes: admin URL + raw hardware key -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/qr_admin_image"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:scaleType="fitXY"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open in Admin"
                            android:textColor="@color/alive_muted"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.1" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/code_card_border"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/qr_key_image"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:scaleType="fitXY"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hardware Key"
                            android:textColor="@color/alive_muted"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.1" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/register_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Register Device"
                    android:textColor="@color/alive_white"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_red_button"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- ── STEP 2: Success confirmation (shown after claim) ── -->
            <LinearLayout
                android:id="@+id/card_step_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTERED"
                    android:textColor="@color/alive_red"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.22"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/success_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/alive_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/code_card_border"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE ID — verify in admin"
                    android:textColor="@color/alive_muted"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:gravity="center"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/success_device_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/alive_white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Match this ID in wearealive.in/admin to confirm"
                    android:textColor="@color/alive_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- ── Error: retry button (shown on failure) ── -->
            <Button
                android:id="@+id/claim_refresh_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Retry"
                android:textColor="@color/alive_white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_ghost_button"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Bottom: progress + status ─────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/claim_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:indeterminateTint="@color/alive_red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pairing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/alive_muted"
            android:textSize="13sp"
            android:fontFamily="monospace" />

    </LinearLayout>

</RelativeLayout>
